{
  "verdict": "Exact cross-season comparability of the CURRENT formulas is UNMEASURABLE from repository inputs. No archived like-for-like 2025 (or earlier) set of current-formula live grades, priors, provider selections and control states exists. The bundled 2025 grades below come from the legacy pipeline with different definitions and are shown descriptively only.",
  "anchorClassification": [
    {
      "key": "pointsScoredPerDriveIndex",
      "classification": "Season-relative (current rank)",
      "anchor": "Recomputed each season from the current league",
      "priorDependence": "Prior from bundled 2025 legacy grade",
      "meaningOf90": "90 means about top 10% of this season, not a fixed points/drive level",
      "providerSampleDependence": "Current-season sample only"
    },
    {
      "key": "qbIndex",
      "classification": "Mixed",
      "anchor": "EPA/success fixed to 2025 full-season QB distribution, but stabilized toward the current league mean; ANY/A current rank; CPOE relative to current league mean; opponent/pressure/recency relative to current season",
      "priorDependence": "Bundled 2025 qbIndex prior",
      "meaningOf90": "Neither purely absolute nor purely relative",
      "providerSampleDependence": "Current-season sample only"
    },
    {
      "key": "receiverIndex",
      "classification": "Season-relative centre, 2025 spread",
      "anchor": "Current league centre is aligned to the 2025 median, so 50 is always this season's average; spread uses the fixed 2025 shape",
      "priorDependence": "Bundled 2025 profiles; ridge beta and centre refitted from them",
      "meaningOf90": "90 means a residual as far above this season's centre as the 2025 90th percentile was above 2025's",
      "providerSampleDependence": "Current-season sample only"
    },
    {
      "key": "olIndex",
      "classification": "Fixed historical anchor",
      "anchor": "Raw disruption rate versus 2025 same-length windows; no centre alignment, so a league-wide change in disruption shifts every team",
      "priorDependence": "Bundled 2025 olIndex prior",
      "meaningOf90": "Closest to \"same absolute performance\" but only against 2025 and only for pass protection",
      "providerSampleDependence": "Current-season sample only"
    },
    {
      "key": "rbIndex",
      "classification": "Season-relative centre, 2025 spread",
      "anchor": "Same design as receivers (LIVE_FITTED frame)",
      "priorDependence": "Bundled 2025 profiles",
      "meaningOf90": "As receivers",
      "providerSampleDependence": "Current-season sample only"
    },
    {
      "key": "coverageIndex",
      "classification": "Season-relative (current rank)",
      "anchor": "Current ranks only",
      "priorDependence": "Bundled 2025 coverageIndex prior",
      "meaningOf90": "Top ~10% of this season",
      "providerSampleDependence": "Current-season sample only"
    },
    {
      "key": "passRushIndex",
      "classification": "Mixed by provider",
      "anchor": "Weekly fallback current rank (28); PFR teams fixed 2025 charted windows (4)",
      "priorDependence": "2025 PFR or dl.pressure_rate percentile",
      "meaningOf90": "Depends on provider; also depends on which provider the team gets",
      "providerSampleDependence": "Yes: provider selection changes the mapping family"
