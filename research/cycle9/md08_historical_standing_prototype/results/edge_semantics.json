{
  "rules": {
    "A": {
      "equalToWorst": "0",
      "equalToBest": "100",
      "worseThanWorst": "0, flagged belowWorst (frozen); under dynamic semantics it becomes the new worst and the frame re-anchors",
      "betterThanBest": "100, flagged aboveBest (frozen: 100 = at or beyond the frozen best); under dynamic semantics it becomes the new best = 100 and earlier values remap down",
      "tied": "midrank of the tied block (interior); worst/best blocks forced to 0/100",
      "median": "Near 50 for these references (4-game: 50.000 all units; 3-game: OL 49.603, others 50.000), but exact 50 is not guaranteed: tied blocks at the centre shift the midrank (reference [0,1,1,1,2,3]: median 1 maps to 40). ~50 means ordinary/middle historical quality, not an exact identity",
      "sparse": "linear interpolation between the adjacent distinct historical values"
    },
    "B": {
      "equalToWorst": "0",
      "equalToBest": "100",
      "worseThanWorst": "0 flagged (as A)",
      "betterThanBest": "100 flagged (as A)",
      "tied": "no special rule: the kernel CDF treats tied values as coincident kernels",
      "median": "not exactly 50 (kernel smoothing); tested references give 47.7-52.6 at 4 games and 44.0-52.5 at 3 games (see probes; tested references only)",
      "sparse": "smooth (kernel) rather than linear; same order as A"
    },
    "C": {
      "equalToWorst": "100*(midrank+0.5)/n, e.g. 0.78 at n=64",
      "equalToBest": "100*(1-0.5/n), e.g. 99.22 at n=64",
      "worseThanWorst": "between 0 and the worst knot via a fitted normal tail; 0 is an asymptote in exact arithmetic, but sufficiently distant finite inputs saturate to exactly 0 in double precision",
      "betterThanBest": "between the best knot and 100 via a fitted normal tail; 100 is an asymptote in exact arithmetic, but sufficiently distant finite inputs saturate to exactly 100 in double precision (e.g. candidateC([0,1,2,3],100) === 100). The historical best itself still maps to 100*(1-0.5/n), not 100",
      "tied": "midrank Hazen position",
      "median": "near 50 (Hazen midrank); exact 50 not guaranteed with tied centre blocks (reference [0,1,1,1,2,3]: 41.667)",
      "sparse": "linear between Hazen positions"
    },
    "tieMedianExample": {
      "reference": [
        0,
        1,
        1,
        1,
        2,
        3
      ],
      "median": 1,
      "A": 40,
      "C": 41.666666666666664
    },
    "numericalSaturationExample": {
      "reference": [
        0,
        1,
        2,
        3
      ],
      "C_at_100": 100,
      "C_at_minus100": 0,
      "C_at_best": 87.5
    },
    "semanticsTradeoff": {
      "frozen": "Reproducible across a season: the same signal always maps to the same number; 100 means at or beyond the frozen historical best (records are flagged, not distinguished).",
      "dynamic": "0/100 always mean worst/best ever including the current season, but a team's number can change because another team set a record, and published numbers are not reproducible without the reference version.",
      "openTail": "Records remain distinguishable above the historical best (until double-precision saturation for very distant values), but the historical best shows ~99.2 (n=64), contradicting the owner's \"100 = best observation\"."
    }
  },
