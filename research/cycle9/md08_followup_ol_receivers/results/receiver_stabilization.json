{
  "construction": {
    "steps": [
      "Raw: WR/TE receiving EPA per target from nflverse weekly player stats (positions WR, TE).",
      "QB coupling: residual = EPA/target - beta*(sack-free QB attempt EPA - centre), beta 0.5880 ridge-fitted on 2025 bundled teams, centre 0.0615 (2025 median QB pass EPA).",
      "Stabilization: stabilizeToward(residual, current target-weighted league residual, targets, 80); reliability weight = targets/(targets+80).",
      "Centre alignment: value - current centre + 2025 reference median, so the current league centre maps to live 50 exactly by construction.",
      "Live grade: continuousPercentileValue against the 32 2025 full-season team residuals (unstabilized, ~328 targets each).",
      "Prior: 2025 residual percentile regressed 30%; display/model value = blend(prior, live, playerStatGames, priorGames)."
    ],
    "anchors": {
      "function historicalWindowValues(": 233,
      "function continuousPercentileValue(": 965,
      "function blend(prior, live, games, priorGames)": 320,
      "receiverResidualStabilizerTargets:80.0": 183,
      "const receiverRoomTargets=sum(recRows,'targets');": 1103,
      "r.receiverResidualEpa=receiverResidualPolicyActive(receiverPolicy)": 1234,
      "const currentReceiverResidual=weightedLeagueMean(": 1249,
      "r.receiverStabilizedResidual=stabilizeToward(": 1265,
      "environmentAlignToHistoricalCenter(r.receiverStabilizedResidual": 1267,
      "const receiverIndex=playerStatsUsable ? blend(": 1604,
      "const priorOlIndex=regressUnitIndex(": 1445,
      "const olHistoricalBench=": 1509,
      "continuousPercentileValue(olHistoricalBench,effectivePressureAllowedRate,false)": 1511,
      "const olIndex=teamStatsUsable ? blend(": 1578
    }
